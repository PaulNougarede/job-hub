# Copier en `.env` (chargé par start.sh) et décommenter ce qui change.
# Les valeurs contenant un espace se mettent entre guillemets.
# Toutes les variables sont optionnelles : sans .env, les valeurs par défaut
# calculées par config.py suffisent.
#
#   cp .env.example .env

# --- Écoute ---------------------------------------------------------------
# Par défaut start.sh écoute sur l'IP Tailscale, sinon 127.0.0.1. Jamais 0.0.0.0.
#HUB_HOST=127.0.0.1
#HUB_PORT=8765

# --- Données locales ------------------------------------------------------
#HUB_DB=data/hub.db
#HUB_LOG_DIR=logs
#HUB_PROMPT_DIR=data/prompts

# --- Projet cv-tailor (dépôt séparé) --------------------------------------
#CV_TAILOR_DIR=$HOME/cv-tailor
#CV_OUTPUT_DIR=$HOME/cv-tailor/output

# --- Entrée produite par le cron de veille --------------------------------
#HUB_INBOX=$HOME/job-hunter/inbox.jsonl
#HUB_SENT_LOG=$HOME/job-hunter/sent.jsonl

# --- Agent d'adaptation ---------------------------------------------------
#HUB_HERMES_BIN=hermes
#HUB_OWNER_NAME="Paul Nougarède"
#HUB_RUN_BUDGET=2700

# --- Démarches France Travail (accord explicite sur Telegram) -------------
# Bot dédié : le créer avec @BotFather, lui envoyer /start, puis relever son
# chat id (getUpdates). Sans ces deux valeurs, aucune démarche n'est créée :
# l'accord est une condition, pas un confort.
#HUB_TELEGRAM_BOT_TOKEN=
#HUB_TELEGRAM_CHAT_ID=
# Identifiant France Travail (hors dépôt : il n'a rien à faire dans un dépôt publiable)
#HUB_FT_IDENTIFIER=
# Attente maximale d'un « go », en secondes
#HUB_FT_GO_TIMEOUT=1800
# Budget d'un passage de l'agent, en secondes
#HUB_FT_BUDGET=900
